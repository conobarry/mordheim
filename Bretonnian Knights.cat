      <rules>
        <rule name="Knights Virtue" id="2c07-4989-da03-9e33" hidden="false">
          <description>A Questing Knight is a chivalrous warrior who is superior to ordinary warriors. He will never panic and break from combat and so does not have to pass a Leadership test for being all alone.</description>
        </rule>
      </rules>
