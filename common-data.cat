      <profiles>
        <profile name="Sling" id="81c2-c5ab-4b0b-f623" hidden="false" page="0" typeId="c4b0233c-e5d1-2b41-3446-45a745fbbbec" typeName="Missile Weapons">
          <characteristics>
            <characteristic name="Range" typeId="a275054b-9b3d-9e68-49e9-7fbb6c714412">18</characteristic>
            <characteristic name="Str" typeId="0e9e02bf-4d20-7ac3-d67f-67172b142b5c">3</characteristic>
            <characteristic name="Special" typeId="fde90816-abbb-f019-75a0-0c24662facf3">Fire twice at half range</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Fire twice at half range" id="3bec-e4c8-c9fd-f975" hidden="false">
          <description>A slinger may fire twice in the shooting phase if he does not move in the movement phase. He cannot shoot over half range (9&quot;) though, if he fires twice.
If the model fires twice then each shot is at -1 to hit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Throwing Knives/Stars" id="23f5-19c3-5a6c-a8fb" collective="false" hidden="false" import="true" page="0" type="upgrade">
