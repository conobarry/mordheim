        </profile>
      </profiles>
      <rules>
        <rule name="Javelins/Harpoons" id="b85e-3c3f-8a27-92e6" hidden="false">
          <description>Javelins are short throwing spears specially weighted to travel quite a distance. Although they have a much reduced range when compared to an arrow they can cause quite considerable damage when thrown by a person of great strength.</description>
        </rule>
      </rules>
    </selectionEntry>
