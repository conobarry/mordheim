    <selectionEntry name="Barding" id="98cf-5b49-a433-c337" collective="false" hidden="false" import="true" page="0" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="30"/>
        <cost name="Warband Rating" typeId="wb-rating" value="0"/>
      </costs>
      <profiles>
        <profile name="Barding" id="675f-2126-9108-d6e0" hidden="false" page="0" typeId="94239014-ea28-23eb-4142-f492dc4caf17" typeName="Armour">
          <characteristics>
            <characteristic name="Armour Save" typeId="26f1ea4e-6017-a8fa-db2b-5c2a83aea46b">+1</characteristic>
            <characteristic name="Special" typeId="ff797ec4-8d7e-cab1-656e-896ae3ed005f">+1 Armor save, Warhorse Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Rarity" id="fcde-1767-d284-0a32" hidden="false">
          <description>Rarity 11</description>
        </rule>
        <rule name="Barding" id="5ec0-4a78-a43c-b0fc" hidden="false">
          <description>Barding is armor for a horse in the same way that light and heavy armor is for a human.
It covers the mount’s hide and in some cases the head.
A model mounted on barded horse receives an additional +1 Armor save (+2 instead of +1 for being mounted).
In addition, a mount wearing barding will only be killed on a D6 roll of a 1 if the model is taken out of action.
Warhorses only.</description>
        </rule>
      </rules>
    </selectionEntry>
