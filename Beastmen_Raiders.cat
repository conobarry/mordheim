              <description>The Beastman may buy one mutation.

See Mutants section on special rules.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Fearless" id="a3ee-7db1-85b1-3dbb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
