  <publications>
    <publication name="Beastman Rules" id="b758-ee46-f27e-58dd" publisher="https://broheim.net/downloads/warbands/unofficial/Beastmen%2C%20Errata%27d.pdf" publisherUrl="https://broheim.net/downloads/warbands/unofficial/Beastmen%2C%20Errata%27d.pdf" shortName="Beastman"/>
  </publications>
  <rules>
    <rule name="Animals" id="879d-152e-f85d-7ccd" hidden="false">
      <description>Beastmen are fearsome creatures of Chaos that do not interact with other races other than in war.

A Beastmen warband may never hire any Hired Swords unless specifically stated with the Hired Sword.</description>
    </rule>
  </rules>
