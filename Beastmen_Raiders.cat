      <rules>
        <rule name="Lowest of the Low" id="5749-4a93-451b-bfe5" hidden="false">
          <description>Ungor are on the lowest rung of Beastmen society and regardless of how much Experience they accrue they will never acquire a position of authority.

If an Ungor rolls ‘That lad’s got talent’ it must be re-rolled.</description>
        </rule>
      </rules>
