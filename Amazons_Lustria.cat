      <rules>
        <rule name="Wizard" id="3080-ed06-abe4-9886" hidden="false">
          <description>The Serpent Priestess is a wizard and may use Amazon Rituals.
She starts with 1 ritual chosen at random from the list over.</description>
        </rule>
      </rules>
