                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Knife Fighter" id="54a2-4dec-2d8c-c64a" hidden="false" page="0">
                  <description>The warrior is an unrivalled expert at using throwing knives and throwing stars.
He can throw a maximum of three of these missiles in his shooting phase and may divide his shots between any targets within range as he wishes.
Note that this skill cannot be combined with the Quick Shot skill.</description>
                </rule>
              </rules>
            </selectionEntry>
