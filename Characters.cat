      <rules>
        <rule name="Pitfighter" id="8deb-82a1-87a2-300a" hidden="false">
          <description>30 gold crowns to hire +15 gold crowns upkeep.
Rating: +22pts (+1/exp)

May be Hired: Any warband except Skaven, Undead and the Possessed may hire a Pit Fighter.</description>
        </rule>
