          </entryLinks>
          <rules>
            <rule name="Leg Wound" id="bdb45ddd-9c7f-f948-a352-fc8b312386ff" hidden="false" page="0">
              <description>The warrior’s leg is broken. He suffers a -1 Movement characteristic penalty from now on.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Severe Arm Wound" id="235f320e-f3a2-d485-4769-0b8a2a88fcf7" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="Warband Rating" typeId="wb-rating" value="0"/>
          </costs>
          <rules>
            <rule name="Severe Arm Wound" id="3c16c046-1533-e807-2947-3c4df51e284c" hidden="false" page="0">
              <description>Severe arm wound. The arm must be amputated. The warrior may only use a single onehanded weapon from now on</description>
            </rule>
          </rules>
        </selectionEntry>
