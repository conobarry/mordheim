              <infoLinks>
                <infoLink id="5b85-fc94-68ef-fdd7" hidden="false" targetId="3ebe96a5-ad6a-b51d-0d99-f62dfb2a807c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Righteous Fury" id="99e7-4de1-7e11-62d4" hidden="false" page="0">
                  <description>The model hates all Skaven, Undead or Possessed warbands and all models in them.</description>
                </rule>
              </rules>
