              <rules>
                <rule name="Mighty Blow" id="1f17-158c-43be-a83c" hidden="false" page="0">
                  <description>The warrior knows how to use his strength to maximum effect and has a +1 Strength bonus in close combat (excluding pistols).
As his Strength is used for close combat weapons, the bonus applies to all such weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Unstoppable Charge" id="8a9e-db88-ce08-8f6d" collective="false" hidden="false" import="true" page="0" type="upgrade">
              <constraints>
                <constraint id="5c36-63de-ee79-a8fd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="6118-ec1b-bc21-2f55" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Unstoppable Charge" id="9c7b-6718-749c-e8a4" hidden="false" page="0">
                  <description>When he charges, the warrior is almost impossible to halt. He adds +1 to his Weapon Skill when charging.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Righteous Fury" id="9edd-b81d-b7b8-fad9" collective="false" hidden="false" import="true" page="0" type="upgrade">
