                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Quick Shot" id="7b96-2c3e-32be-12b1" hidden="false" page="0">
                  <description>The warrior may shoot twice per turn with a bow or crossbow (but not a crossbow pistol).</description>
                </rule>
              </rules>
