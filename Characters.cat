              </costs>
              <rules>
                <rule name="The Noctu" id="d8e2-3543-714c-e8c3" hidden="false">
                  <description>The gemstone stolen from Serutat’s lair has powerful cloaking properties.
The veil of shadow it creates reduces all shooting to hit rolls against Marianna by -1.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
