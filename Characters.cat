              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Knife Fighter" id="1dd3-8c3b-143a-d056" hidden="false" page="0">
                  <description>The warrior is an unrivalled expert at using throwing knives and throwing stars.
He can throw a maximum of three of these missiles in his shooting phase and may divide his shots between any targets within range as he wishes.
Note that this skill cannot be combined with the Quick Shot skill.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Lightning Reflexes" id="2fe4-926a-93f3-9edf" collective="false" hidden="false" import="true" page="0" type="upgrade">
              <constraints>
                <constraint id="c048-90f7-f91d-dad1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="22f3-46a4-6bfe-08a1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Lightning Reflexes" id="5dae-70cd-afe0-fc3f" hidden="false" page="0">
                  <description>If the warrior is charged he will ‘strike first’ against those that charged that turn. As the charger(s) will also normally ‘strike first’ (for
charging), the order of attack between the charger(s) and the warrior with this skill will be determined by comparing Initiative values.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Step Aside" id="a835-b952-ee21-ce6c" collective="false" hidden="false" import="true" page="0" type="upgrade">
              <constraints>
                <constraint id="0dd0-283b-c032-1016" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="05ed-2e37-08bc-8046" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Warband Rating" typeId="wb-rating" value="0"/>
              </costs>
              <rules>
                <rule name="Step Aside" id="0efc-c241-3fe8-aee9" hidden="false" page="0">
                  <description>Each time he suffers a wound in close combat he may make an additional saving throw of 5+. This save is never modified and is taken after all other armour saves.</description>
                </rule>
              </rules>
            </selectionEntry>
