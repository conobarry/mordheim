                  <description>He adds +6&quot; to the range of any missile weapon he is using.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Quick Shot" id="2589-ced3-e3f8-cc09" collective="false" hidden="false" import="true" page="0" type="upgrade">
