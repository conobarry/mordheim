            <rule name="Chest Wound" id="033c9c03-9ee3-ed99-6488-6d5c93c2ff81" hidden="false" page="0">
              <description>The warrior has been badly wounded in the chest. He recovers but is weakened by the injury so his Toughness is reduced by 1</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Blind In one Eye" id="dbccc133-7061-c16e-eb8b-ab7a378c418c" collective="false" hidden="false" import="true" page="0" type="upgrade">
