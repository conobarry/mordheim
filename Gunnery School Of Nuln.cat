      <rules>
        <rule name="Crack Shot" id="fc86-c0cd-fb0f-1deb" hidden="false">
          <description>Experts with pistols in close quarters; they have an uncanny ability to turn what should have missed its target into a success.
When using pistols in close combat, they may re-roll any missed to-hit rolls with the pistol in the first round of combat.</description>
        </rule>
      </rules>
