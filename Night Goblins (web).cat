        <cost name="Warriors" typeId="b677-8cc2-f3d9-d65e" value="1"/>
      </costs>
      <modifiers>
        <modifier field="f606-0f4b-13fe-ea4f" type="set" value="0">
          <conditions>
            <condition childId="4038-4cc8-456f-8466" childName="Troll" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Great Squig" id="7742-fe1d-1631-81e0" hidden="false" typeId="e1beaa44-e54d-dd6b-d1f2-446b333c9bb9" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="2a0bcc4c-8266-418f-13d6-a6b44def5e92">3D6</characteristic>
            <characteristic name="WS" typeId="d5aca8ba-0204-b324-b976-c2b536e09924">4</characteristic>
            <characteristic name="BS" typeId="5b4d181b-23ae-5ed7-9262-c1d2f79246a8">0</characteristic>
            <characteristic name="S" typeId="7f1f0a4d-68dc-b0df-5703-c4d0d91a93b9">5</characteristic>
            <characteristic name="T" typeId="54f4796b-dedb-c296-8b1a-ff7f8043293a">5</characteristic>
            <characteristic name="W" typeId="3172c8dc-ebe4-0c40-72ab-8fd0076b9442">3</characteristic>
            <characteristic name="I" typeId="a6fd52b0-be0a-655e-6314-87b392c9c90e">4</characteristic>
            <characteristic name="A" typeId="bf393c37-9d10-fc85-c147-62b1c01a89fe">3</characteristic>
            <characteristic name="LD" typeId="e234eaea-a02a-2fb7-3e1f-605392aabb89">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Movement" id="261c-f49c-faa6-a9e5" hidden="false" typeId="aa94-5d6e-9b87-dda7" typeName="Special Rules">
          <characteristics>
            <characteristic name="Description" typeId="f258-8283-7780-a442">Great Squigs do not have a set Movement characteristic but move with an ungainly bouncing stride. When moving a Great Squig, declare a direction of movement and roll 3D6 for the distance they move. Great Squigs never run and never declare charges. Instead, they are allowed to contact enemy models with their normal 3D6&quot; movement, stopping short if they do. If this happens, they count as charging for the following round of hand-to-hand combat, just as if they had declared a charge.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cause Fear" id="d180-461b-72c8-6139" hidden="false" typeId="aa94-5d6e-9b87-dda7" typeName="Special Rules">
          <characteristics>
            <characteristic name="Description" typeId="f258-8283-7780-a442">Great Squigs are massive balls of flesh and teeth, they cause Fear.</characteristic>
          </characteristics>
        </profile>
        <profile name="Large Target" id="038b-148c-af0a-b3eb" hidden="false" typeId="aa94-5d6e-9b87-dda7" typeName="Special Rules">
          <characteristics>
            <characteristic name="Description" typeId="f258-8283-7780-a442">Great Squigs are large targets as defined in the shooting rules.</characteristic>
          </characteristics>
        </profile>
        <profile name="Animal" id="b263-869f-0587-3bbb" hidden="false" typeId="aa94-5d6e-9b87-dda7" typeName="Special Rules">
          <characteristics>
            <characteristic name="Description" typeId="f258-8283-7780-a442">Great Squigs are animals of a sort and so do not gain experience, or climb ladders. They can move up to higher levels or over obstacles using the normal climb rules, just imagine it as a particularly high bounce.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Troll" id="4038-4cc8-456f-8466" hidden="false" import="true" type="model">
